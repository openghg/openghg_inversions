  "cases": [
    {
      "id": "explicit-public-bc-selection",
      "affected_ledger": [
        "I4",
        "legacy-basis",
        "BC resources"
      ],
      "original_input": {
        "data.use_bc": true,
        "data.bc_basis_paths": null
      },
      "original_expectation": "DataConfig has no bc_basis_algorithm field. Full/staged/nested use_bc+exact paths load a Dataset; otherwise None selects resource-free NESW from acquired directional contributions. use_bc=False performs no BC basis I/O.",
      "approved_comparison": "Add canonical bc_basis_algorithm default NESW. use_bc=False bypasses BC basis I/O; exact paths win and algorithm becomes inactive; otherwise NESW resolves to same None numerical operand. Preserve labels, units, temporal/grid alignment and borrowed lazy arrays. No historical selector recognition.",
